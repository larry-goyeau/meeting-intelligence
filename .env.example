# ---------------------------------------------------------------------------
# The app runs with NO configuration at all: with no API key it falls back to
# a deterministic local provider (hashed embeddings + extractive answering).
# That mode is what the test suite and CI use. Set a key for real quality.
# ---------------------------------------------------------------------------

# Leave empty to run in deterministic offline mode.
OPENAI_API_KEY=

# Optional: point at Azure OpenAI, OpenRouter, Ollama, vLLM, ... anything
# exposing an OpenAI-compatible /v1 surface.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model selection (defaults shown).
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
TRANSCRIPTION_MODEL=whisper-1

# Retrieval tuning. See the README's "RAG design" section for the reasoning.
RETRIEVAL_DENSE_K=24
RETRIEVAL_LEXICAL_K=24
RETRIEVAL_FINAL_K=10
RETRIEVAL_MMR_LAMBDA=0.7
RETRIEVAL_NEIGHBOR_RADIUS=1
# Slots reserved for each retriever's own top hits before fusion decides the rest.
RETRIEVAL_PER_RETRIEVER_FLOOR=2
CONTEXT_TOKEN_BUDGET=6000
CHUNK_TARGET_TOKENS=320
CHUNK_OVERLAP_TOKENS=60

# Where the SQLite database and uploaded transcripts live.
DATA_DIR=.data

# json (production) or pretty (local)
LOG_FORMAT=pretty
