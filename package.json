{
  "name": "meeting-intelligence",
  "version": "1.0.0",
  "private": true,
  "description": "Conversational meeting intelligence over transcripts: hybrid RAG with timestamped, verifiable citations.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/run.mjs scripts/seed.ts",
    "eval": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/run.mjs scripts/eval.ts",
    "gate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/run.mjs scripts/gate.ts",
    "reset": "rm -rf .data"
  },
  "dependencies": {
    "next": "^16.3.3",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
